        "api",
        "apiverve",
        "xmltojson",
        "xml to json",
        "xml to json api",
        "convert xml to json",
        "change xml to json",
        "xml to json converter api"
    ],
    "homepage": "https://apiverve.com/marketplace/xmltojson?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/xmltojson",
